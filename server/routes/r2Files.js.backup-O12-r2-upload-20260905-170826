import express from 'express';
import crypto from 'crypto';
import db, { queryDb, getDb, runDb } from '../config/db.js';
import { authMiddleware } from '../middleware/authMiddleware.js';
import { createPresignedUploadUrl, createPresignedDownloadUrl, deleteR2Object } from '../services/r2Service.js';
import { checkStorageQuota, recordStorageUsage, getMonthlyStorageUsage } from '../services/quotaService.js';
import { writeAuditEvent } from '../services/auditLogger.js';

const router = express.Router();

// Supported Healthcare File Categories
const ALLOWED_CATEGORIES = [
    'lab_report',
    'mri',
    'ct_scan',
    'xray',
    'prescription',
    'insurance',
    'certificate',
    'profile_image',
    'medical_pdf',
    'other_attachment'
];

// Max file size limit: 100MB
const MAX_FILE_SIZE_BYTES = 100 * 1024 * 1024;

/**
 * Resolve and authorize access to an R2 document.
 * Authorization is always based on Neon relationships, never client-supplied metadata.
 */
async function authorizeDocumentAccess(req, meta) {
    if (!meta) return { allowed: false, code: 'FILE_NOT_FOUND' };

    const userId = req.user?.uid || req.user?.userId;
    const role = req.role || req.user?.role || 'patient';

    if (!userId) {
        return { allowed: false, code: 'AUTH_REQUIRED' };
    }

    const user = await getDb(
        `SELECT id, role, status, hospital_id
         FROM users
         WHERE id = ?
         LIMIT 1`,
        [userId]
    );

    if (!user || user.status !== 'active') {
        return { allowed: false, code: 'USER_NOT_ACTIVE' };
    }

    if (user.role !== role) {
        return { allowed: false, code: 'ROLE_MISMATCH' };
    }

    if (role === 'super_admin') {
        return { allowed: true };
    }

    if (role === 'patient') {
        const patient = await getDb(
            `SELECT id, hospital_id
             FROM patients
             WHERE user_id = ?
             LIMIT 1`,
            [userId]
        );

        if (!patient) {
            return { allowed: false, code: 'PATIENT_PROFILE_REQUIRED' };
        }

        const ownsFile =
            String(meta.patient_id || '') === String(patient.id) ||
            String(meta.uploaded_for || '') === String(patient.id) ||
            String(meta.uploaded_by || '') === String(userId);

        return { allowed: ownsFile };
    }

    if (role === 'doctor') {
        const doctor = await getDb(
            `SELECT id, hospital_id
             FROM doctors
             WHERE user_id = ?
             LIMIT 1`,
            [userId]
        );

        if (!doctor || !doctor.hospital_id) {
            return { allowed: false, code: 'DOCTOR_PROFILE_REQUIRED' };
        }

        const sameHospital =
            meta.hospital_id &&
            String(meta.hospital_id) === String(doctor.hospital_id);

        const isOwnUpload =
            String(meta.uploaded_by || '') === String(userId) ||
            String(meta.doctor_id || '') === String(doctor.id);

        if (isOwnUpload && sameHospital) {
            return { allowed: true };
        }

        if (!sameHospital || !meta.patient_id) {
            return { allowed: false };
        }

        const activeSession = await getDb(
            `SELECT aas.id
             FROM active_access_sessions aas
             JOIN patients p ON p.id = aas.patient_id
             WHERE aas.doctor_id = ?
               AND aas.patient_id = ?
               AND p.hospital_id = ?
               AND aas.revoked_at IS NULL
               AND aas.expires_at > CURRENT_TIMESTAMP
             LIMIT 1`,
            [doctor.id, meta.patient_id, doctor.hospital_id]
        );

        return { allowed: !!activeSession };
    }

    if (['clinical', 'hospital_admin', 'admin'].includes(role)) {
        if (!user.hospital_id || !meta.hospital_id) {
            return { allowed: false, code: 'HOSPITAL_CONTEXT_REQUIRED' };
        }

        return {
            allowed: String(user.hospital_id) === String(meta.hospital_id)
        };
    }

    return { allowed: false, code: 'R2_ACCESS_DENIED' };
}


/**
 * 1. POST /api/r2/presigned-upload-url
 */
router.post('/r2/presigned-upload-url', authMiddleware, async (req, res) => {
    try {
        const {
            fileName,
            fileType = 'medical_pdf',
            fileSize,
            contentType = 'application/pdf',
            patientId,
            doctorId,
            hospitalId,
            departmentId = 'radiology',
            visibilityScope = 'hospital_internal',
            consentStatus = 'approved'
        } = req.body;

        if (!fileName) {
            return res.status(400).json({ success: false, message: 'fileName is required.' });
        }

        const bytesToUpload = Number(fileSize) || 0;
        if (bytesToUpload > MAX_FILE_SIZE_BYTES) {
            return res.status(400).json({ success: false, message: 'File size exceeds maximum permitted limit of 100MB.' });
        }

        const category = ALLOWED_CATEGORIES.includes(fileType) ? fileType : 'medical_pdf';
        const targetTenant = hospitalId || req.hospitalId || 'default_hospital';
        const targetPatient = patientId || (req.role === 'patient' ? req.user.uid : 'pat_gen_' + req.user.uid.slice(0, 6));
        const targetDoctor = doctorId || (req.role === 'doctor' ? req.user.uid : null);

        // SERVER-SIDE QUOTA CHECK
        const quotaCheck = await checkStorageQuota({
            hospitalId: targetTenant,
            requestedBytes: bytesToUpload,
            operationType: 'upload'
        });

        if (!quotaCheck.isAllowed) {
            await writeAuditEvent({
                userId: req.user.uid,
                role: req.role || 'patient',
                action: 'FILE_UPLOAD_BLOCKED_QUOTA',
                resourceType: 'file',
                resourceId: fileName,
                details: { reason: quotaCheck.reason, warningLevel: quotaCheck.warningLevel },
                status: 'BLOCKED'
            });

            return res.status(429).json({
                success: false,
                isQuotaExceeded: true,
                warningLevel: quotaCheck.warningLevel,
                message: 'Monthly storage limit reached. Please upgrade your storage plan.',
                reason: quotaCheck.reason,
                resetAt: quotaCheck.resetAt
            });
        }

        // Generate unique R2 file ID and Object Key
        const fileId = `r2_doc_${crypto.randomBytes(8).toString('hex')}`;
        const sanitizedFileName = fileName.replace(/[^a-zA-Z0-9_.-]/g, '_');
        const objectKey = `hospitals/${targetTenant}/patients/${targetPatient}/${category}/${new Date().getFullYear()}/${fileId}_${sanitizedFileName}`;

        // Generate S3-compatible Presigned Upload URL for Cloudflare R2
        const presignedData = await createPresignedUploadUrl({
            objectKey,
            contentType,
            expiresInSeconds: 900 // 15 minutes
        });

        // Audit Log
        const auditLog = await writeAuditEvent({
            userId: req.user.uid,
            role: req.role || 'patient',
            action: 'FILE_UPLOAD_INITIATED',
            resourceType: 'file_document',
            resourceId: fileId,
            details: { objectKey, fileName: sanitizedFileName, fileSize: bytesToUpload, contentType },
            status: 'PENDING'
        });

        // Store Document Metadata in Neon PostgreSQL
        const fileMetadata = {
            fileId,
            fileName: sanitizedFileName,
            fileType: category,
            fileSize: bytesToUpload,
            contentType,
            storageProvider: 'cloudflare-r2',
            bucketName: presignedData.bucketName,
            objectKey,
            uploadedBy: req.user.uid,
            uploadedFor: targetPatient,
            patientId: targetPatient,
            doctorId: targetDoctor,
            hospitalId: targetTenant,
            departmentId,
            visibilityScope,
            consentStatus,
            uploadStatus: 'pending',
            auditId: auditLog.auditId,
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
        };

        try {
            await runDb(
                `INSERT INTO documents (
                    id, file_id, file_name, document_type, mime_type, file_size, 
                    storage_provider, storage_key, bucket_name, uploaded_by, 
                    visibility_scope, consent_status, upload_status, audit_id, created_at, updated_at
                ) VALUES (
                    gen_random_uuid(), ?, ?, ?, ?, ?, 
                    'cloudflare-r2', ?, ?, ?, 
                    ?, ?, 'pending', ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
                )`,
                [
                    fileId,
                    sanitizedFileName,
                    category,
                    contentType,
                    bytesToUpload,
                    objectKey,
                    presignedData.bucketName,
                    req.user.uid,
                    visibilityScope,
                    consentStatus,
                    auditLog.auditId
                ]
            );
        } catch (dbErr) {
            console.warn('[Documents Insert Notice]:', dbErr.message);
        }

        res.status(201).json({
            success: true,
            fileId,
            uploadUrl: presignedData.uploadUrl,
            expiresIn: presignedData.expiresIn,
            warningLevel: quotaCheck.warningLevel,
            metadata: fileMetadata
        });
    } catch (err) {
        console.error('[R2 Upload Presign Error]', err);
        res.status(500).json({ success: false, message: 'Failed to generate presigned upload URL: ' + err.message });
    }
});

/**
 * 2. POST /api/r2/confirm-upload
 */
router.post('/r2/confirm-upload', authMiddleware, async (req, res) => {
    try {
        const { fileId } = req.body;
        if (!fileId) {
            return res.status(400).json({ success: false, message: 'fileId is required.' });
        }

        let docRow = await getDb(`SELECT * FROM documents WHERE file_id = ? LIMIT 1`, [fileId]);

        if (!docRow) {
            return res.status(404).json({
                success: false,
                code: 'FILE_NOT_FOUND',
                message: 'File metadata was not found.'
            });
        }

        if (docRow.upload_status === 'deleted') {
            return res.status(410).json({
                success: false,
                code: 'FILE_DELETED',
                message: 'This file has already been deleted.'
            });
        }

        const access = await authorizeDocumentAccess(req, docRow);
        if (!access.allowed) {
            return res.status(403).json({
                success: false,
                code: access.code || 'R2_ACCESS_DENIED',
                message: 'You are not authorized to confirm this upload.'
            });
        }

        const userId = req.user?.uid || req.user?.userId;
        const role = req.role || req.user?.role || 'patient';

        if (role !== 'super_admin' && String(docRow.uploaded_by || '') !== String(userId)) {
            return res.status(403).json({
                success: false,
                code: 'R2_UPLOAD_CONFIRM_DENIED',
                message: 'Only the uploader or super administrator can confirm this upload.'
            });
        }

        const auditLog = await writeAuditEvent({
            userId: req.user.uid,
            action: 'FILE_UPLOAD_CONFIRMED',
            resourceType: 'file_document',
            resourceId: fileId,
            status: 'SUCCESS'
        });

        // Record Quota Usage in PostgreSQL
        const fileSize = docRow ? Number(docRow.file_size) : 0;
        const updatedQuota = await recordStorageUsage({
            hospitalId: req.hospitalId || 'default_hospital',
            departmentId: 'general',
            userId: req.user.uid,
            bytesDelta: fileSize,
            operationType: 'upload',
            fileType: docRow?.document_type || 'medical_pdf'
        });

        try {
            await runDb(
                `UPDATE documents SET upload_status = 'active', updated_at = CURRENT_TIMESTAMP, audit_id = ? WHERE file_id = ?`,
                [auditLog.auditId, fileId]
            );
        } catch (e) {}

        res.json({
            success: true,
            message: 'File upload confirmed and metadata saved in Neon PostgreSQL.',
            metadata: {
                fileId,
                uploadStatus: 'active',
                updatedAt: new Date().toISOString()
            },
            quota: updatedQuota
        });
    } catch (err) {
        res.status(500).json({ success: false, message: err.message });
    }
});

/**
 * 3. POST /api/r2/presigned-download-url
 */
router.post('/r2/presigned-download-url', authMiddleware, async (req, res) => {
    try {
        const { fileId } = req.body;
        if (!fileId) {
            return res.status(400).json({ success: false, message: 'fileId is required.' });
        }

        const meta = await getDb(`SELECT * FROM documents WHERE file_id = ? LIMIT 1`, [fileId]);

        if (meta) {
            const access = await authorizeDocumentAccess(req, meta);
            if (!access.allowed) {
                return res.status(access.code === 'FILE_NOT_FOUND' ? 404 : 403).json({
                    success: false,
                    code: access.code || 'R2_ACCESS_DENIED',
                    message: 'You are not authorized to access this file.'
                });
            }
        }

        if (!meta) {
            // Check in medical_records if not in documents
            const rec = await getDb(`SELECT * FROM medical_records WHERE r2_file_id = ? OR id = ? LIMIT 1`, [fileId, fileId]);
            if (!rec) {
                return res.status(404).json({ success: false, message: 'File record not found.' });
            }

            const recordMeta = {
                ...rec,
                patient_id: rec.patient_id,
                doctor_id: rec.doctor_id,
                hospital_id: rec.hospital_id,
                uploaded_by: rec.created_by || rec.updated_by || null,
                uploaded_for: rec.patient_id
            };

            const access = await authorizeDocumentAccess(req, recordMeta);
            if (!access.allowed) {
                return res.status(403).json({
                    success: false,
                    code: access.code || 'R2_ACCESS_DENIED',
                    message: 'You are not authorized to access this medical record.'
                });
            }

            const downloadUrl = rec.download_url;
            if (!downloadUrl) {
                return res.status(404).json({
                    success: false,
                    code: 'FILE_URL_NOT_FOUND',
                    message: 'No download URL is available for this medical record.'
                });
            }
            return res.json({
                success: true,
                downloadUrl,
                fileName: rec.file_name || 'document.pdf',
                contentType: 'application/pdf'
            });
        }

        const objectKey = meta.storage_key;
        const presignedData = await createPresignedDownloadUrl({
            objectKey,
            expiresInSeconds: 900
        });

        await writeAuditEvent({
            userId: req.user.uid,
            action: 'FILE_DOWNLOAD',
            resourceType: 'file_document',
            resourceId: fileId,
            status: 'SUCCESS'
        });

        res.json({
            success: true,
            downloadUrl: presignedData.downloadUrl,
            expiresIn: presignedData.expiresIn,
            fileName: meta.file_name,
            contentType: meta.mime_type,
            metadata: meta
        });
    } catch (err) {
        res.status(500).json({ success: false, message: err.message });
    }
});

