/**
 * 5. GET /api/r2/files
 */
router.get('/r2/files', authMiddleware, async (req, res) => {
    try {
        const { category } = req.query;
        const userId = req.user?.uid || req.user?.userId;
        const role = req.role || req.user?.role || 'patient';

        if (!userId) {
            return res.status(401).json({
                success: false,
                code: 'AUTH_REQUIRED',
                message: 'Authentication required.'
            });
        }

        const user = await getDb(
            `SELECT id, role, status, hospital_id
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [userId]
        );

        if (!user || user.status !== 'active' || user.role !== role) {
            return res.status(403).json({
                success: false,
                code: 'R2_ACCESS_DENIED',
                message: 'You are not authorized to list these files.'
            });
        }

        let sql = `SELECT * FROM documents WHERE upload_status != 'deleted'`;
        const params = [];

        if (role === 'super_admin') {
            // Global administrative visibility.
        } else if (role === 'patient') {
            const patient = await getDb(
                `SELECT id
                 FROM patients
                 WHERE user_id = ?
                 LIMIT 1`,
                [userId]
            );

            if (!patient) {
                return res.status(403).json({
                    success: false,
                    code: 'PATIENT_PROFILE_REQUIRED',
                    message: 'Registered patient profile required.'
                });
            }

            sql += ` AND (patient_id = ? OR uploaded_for = ? OR uploaded_by = ?)`;
            params.push(patient.id, patient.id, userId);
        } else if (role === 'doctor') {
            const doctor = await getDb(
                `SELECT id, hospital_id
                 FROM doctors
                 WHERE user_id = ?
                 LIMIT 1`,
                [userId]
            );

            if (!doctor || !doctor.hospital_id) {
                return res.status(403).json({
                    success: false,
                    code: 'DOCTOR_PROFILE_REQUIRED',
                    message: 'Approved doctor profile with hospital context required.'
                });
            }

            sql += ` AND (
                uploaded_by = ?
                OR (doctor_id = ? AND hospital_id = ?)
                OR (
                    hospital_id = ?
                    AND patient_id IN (
                        SELECT aas.patient_id
                        FROM active_access_sessions aas
                        WHERE aas.doctor_id = ?
                          AND aas.revoked_at IS NULL
                          AND aas.expires_at > CURRENT_TIMESTAMP
                    )
                )
            )`;
            params.push(
                userId,
                doctor.id,
                doctor.hospital_id,
                doctor.hospital_id,
                doctor.id
            );
        } else if (['clinical', 'hospital_admin', 'admin'].includes(role)) {
            if (!user.hospital_id) {
                return res.status(403).json({
                    success: false,
                    code: 'HOSPITAL_CONTEXT_REQUIRED',
                    message: 'Hospital context is required.'
                });
            }

            sql += ` AND hospital_id = ?`;
            params.push(user.hospital_id);
        } else {
            return res.status(403).json({
                success: false,
                code: 'R2_ACCESS_DENIED',
                message: 'You are not authorized to list these files.'
            });
        }

        if (category && category !== 'all') {
            sql += ` AND document_type = ?`;
            params.push(category);
        }

        sql += ` ORDER BY created_at DESC LIMIT 100`;

        const rows = await queryDb(sql, params);

        const files = rows.map(r => ({
            fileId: r.file_id,
            fileName: r.file_name,
            fileType: r.document_type,
            fileSize: Number(r.file_size),
            contentType: r.mime_type,
            uploadStatus: r.upload_status,
            createdAt: r.created_at
        }));

        res.json({
            success: true,
            totalFiles: files.length,
            files
        });
    } catch (err) {
        res.status(500).json({ success: false, message: err.message, files: [] });
    }
});

/**
 * 6. DELETE /api/r2/file/:fileId
 */
router.delete('/r2/file/:fileId', authMiddleware, async (req, res) => {
    try {
        const { fileId } = req.params;
        const meta = await getDb(`SELECT * FROM documents WHERE file_id = ? LIMIT 1`, [fileId]);

        if (meta) {
            const access = await authorizeDocumentAccess(req, meta);
            if (!access.allowed) {
                return res.status(403).json({
                    success: false,
                    code: access.code || 'R2_ACCESS_DENIED',
                    message: 'You are not authorized to delete this file.'
                });
            }

            const role = req.role || req.user?.role || 'patient';
            const userId = req.user?.uid || req.user?.userId;

            const canDelete =
                role === 'super_admin' ||
                String(meta.uploaded_by || '') === String(userId);

            if (!canDelete) {
                return res.status(403).json({
                    success: false,
                    code: 'R2_DELETE_DENIED',
                    message: 'Only the uploader or super administrator can delete this file.'
                });
            }

            try {
                await deleteR2Object({ objectKey: meta.storage_key });
            } catch (e) {
                console.error('[R2 Delete Error]', e);
                return res.status(502).json({
                    success: false,
                    code: 'R2_DELETE_FAILED',
                    message: 'Failed to delete the file from object storage.'
                });
            }

            await runDb(`UPDATE documents SET upload_status = 'deleted', updated_at = CURRENT_TIMESTAMP WHERE file_id = ?`, [fileId]);

            await recordStorageUsage({
                hospitalId: req.hospitalId || 'default_hospital',
                bytesDelta: -Number(meta.file_size || 0),
                operationType: 'delete'
            });
        }

        await writeAuditEvent({
            userId: req.user.uid,
            action: 'FILE_DELETE',
            resourceType: 'file_document',
            resourceId: fileId,
            status: 'SUCCESS'
        });

        res.json({
            success: true,
            message: 'File record marked as deleted in Neon PostgreSQL.',
            fileId
        });
    } catch (err) {
        res.status(500).json({ success: false, message: err.message });
    }
});

/**
 * 7. GET /api/r2/audit-logs
 */
router.get('/r2/audit-logs', authMiddleware, async (req, res) => {
    try {
        const userId = req.user?.uid || req.user?.userId;
        const role = req.role || req.user?.role || 'patient';

        if (!userId) {
            return res.status(401).json({
                success: false,
                code: 'AUTH_REQUIRED',
                message: 'Authentication required.'
            });
        }

        const user = await getDb(
            `SELECT id, role, status, hospital_id
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [userId]
        );

        if (!user || user.status !== 'active' || user.role !== role) {
            return res.status(403).json({
                success: false,
                code: 'R2_AUDIT_ACCESS_DENIED',
                message: 'You are not authorized to view audit logs.'
            });
        }

        if (!['super_admin', 'hospital_admin', 'admin'].includes(role)) {
            return res.status(403).json({
                success: false,
                code: 'R2_AUDIT_ACCESS_DENIED',
                message: 'Administrative access is required to view audit logs.'
            });
        }

        let sql = `
            SELECT id, actor_user_id as "requestedBy", action, resource_type as "fileType",
                   resource_id as "fileId", status, timestamp, details
            FROM audit_logs
        `;
        const params = [];

        if (role !== 'super_admin') {
            if (!user.hospital_id) {
                return res.status(403).json({
                    success: false,
                    code: 'HOSPITAL_CONTEXT_REQUIRED',
                    message: 'Hospital context is required.'
                });
            }

            sql += `
                WHERE actor_user_id IN (
                    SELECT id
                    FROM users
                    WHERE hospital_id = ?
                )
            `;
            params.push(user.hospital_id);
        }

        sql += ` ORDER BY timestamp DESC LIMIT 50`;

        const rows = await queryDb(sql, params);

        const auditLogs = rows.map(r => ({
            id: r.id,
            auditId: r.id,
            action: r.action,
            fileId: r.fileId,
            requestedBy: r.requestedBy,
            status: r.status,
            timestamp: r.timestamp,
            details: typeof r.details === 'string' ? JSON.parse(r.details) : r.details
        }));

        res.json({
            success: true,
            totalLogs: auditLogs.length,
            auditLogs
        });
    } catch (err) {
        res.status(500).json({ success: false, message: err.message, auditLogs: [] });
    }
});

/**
 * 8. GET /api/r2/storage-quota
 */
router.get('/r2/storage-quota', authMiddleware, async (req, res) => {
    try {
        const userId = req.user?.uid || req.user?.userId;
        const role = req.role || req.user?.role || 'patient';

        if (!userId) {
            return res.status(401).json({
                success: false,
                code: 'AUTH_REQUIRED',
                message: 'Authentication required.'
            });
        }

        const user = await getDb(
            `SELECT id, role, status, hospital_id
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [userId]
        );

        if (!user || user.status !== 'active' || user.role !== role) {
            return res.status(403).json({
                success: false,
                code: 'R2_QUOTA_ACCESS_DENIED',
                message: 'You are not authorized to view storage quota.'
            });
        }

        const requestedHospital = req.query.hospitalId || null;

        if (role === 'super_admin') {
            if (!requestedHospital) {
                return res.status(400).json({
                    success: false,
                    code: 'HOSPITAL_ID_REQUIRED',
                    message: 'hospitalId is required for super administrator quota queries.'
                });
            }
        } else {
            if (!user.hospital_id) {
                return res.status(403).json({
                    success: false,
                    code: 'HOSPITAL_CONTEXT_REQUIRED',
                    message: 'Hospital context is required.'
                });
            }

            if (requestedHospital && String(requestedHospital) !== String(user.hospital_id)) {
                return res.status(403).json({
                    success: false,
                    code: 'CROSS_HOSPITAL_ACCESS_DENIED',
                    message: 'You cannot access another hospital storage quota.'
                });
            }
        }

        const targetHospital = requestedHospital || user.hospital_id;

        if (!targetHospital) {
            return res.status(403).json({
                success: false,
                code: 'HOSPITAL_CONTEXT_REQUIRED',
                message: 'Hospital context is required.'
            });
        }

        const quotaInfo = await checkStorageQuota({ hospitalId: targetHospital });
        const usage = quotaInfo.usage;

        res.json({
            success: true,
            hospitalId: targetHospital,
            month: usage.month,
            totalStorageBytes: usage.totalStorageBytes || 0,
            maxStorageBytes: usage.maxStorageBytes || 10737418240,
            storagePercentage: Number(((usage.totalStorageBytes / usage.maxStorageBytes) * 100).toFixed(2)),
            uploadCount: usage.uploadCount || 0,
            downloadCount: usage.downloadCount || 0,
            previewCount: usage.previewCount || 0,
            deleteCount: usage.deleteCount || 0,
            classARequests: usage.classARequests || 0,
            maxClassARequests: usage.maxClassARequests || 1000000,
            classAPercentage: Number(((usage.classARequests / usage.maxClassARequests) * 100).toFixed(2)),
            classBRequests: usage.classBRequests || 0,
            maxClassBRequests: usage.maxClassBRequests || 10000000,
            classBPercentage: Number(((usage.classBRequests / usage.maxClassBRequests) * 100).toFixed(2)),
            warningLevel: usage.warningLevel || 'normal',
            isBlocked: usage.isBlocked || false,
            resetAt: usage.resetAt,
            categoryBreakdown: usage.categoryBreakdown || {}
        });
    } catch (err) {
        res.status(500).json({ success: false, message: err.message });
    }
});

export default router;
