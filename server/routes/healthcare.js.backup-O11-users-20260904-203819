// 4. POST /api/consents - Patient grants consent to another user
router.post('/consents', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId;
        const requester = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [requesterId]
        );

        if (!requester || requester.status !== 'active') {
            return res.status(403).json({
                success: false,
                code: 'ACCOUNT_NOT_ACTIVE',
                message: 'Active authenticated account required.'
            });
        }

        if (requester.role !== 'patient') {
            return res.status(403).json({
                success: false,
                code: 'PATIENT_CONSENT_REQUIRED',
                message: 'Only the patient may grant this consent.'
            });
        }

        const patient = await getDb(
            `SELECT id, hospital_id AS "hospitalId"
             FROM patients
             WHERE user_id = ?
             LIMIT 1`,
            [requester.id]
        );

        if (!patient) {
            return res.status(403).json({
                success: false,
                code: 'PATIENT_PROFILE_REQUIRED',
                message: 'Registered patient profile required.'
            });
        }

        const { grantedTo, purpose, scope = 'all_records', expiresAt } = req.body || {};

        if (!grantedTo || !purpose) {
            return res.status(400).json({
                success: false,
                message: 'grantedTo and purpose are required.'
            });
        }

        const recipient = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [grantedTo]
        );

        if (!recipient || recipient.status !== 'active') {
            return res.status(400).json({
                success: false,
                code: 'INVALID_CONSENT_RECIPIENT',
                message: 'Consent recipient is not an active HealthChain user.'
            });
        }

        if (String(recipient.id) === String(requester.id)) {
            return res.status(400).json({
                success: false,
                code: 'SELF_CONSENT_NOT_ALLOWED',
                message: 'A patient cannot grant consent to themselves.'
            });
        }

        if (
            recipient.hospitalId &&
            patient.hospitalId &&
            String(recipient.hospitalId) !== String(patient.hospitalId) &&
            !['admin', 'super_admin'].includes(recipient.role)
        ) {
            return res.status(403).json({
                success: false,
                code: 'HOSPITAL_ACCESS_DENIED',
                message: 'Consent recipient belongs to another hospital.'
            });
        }

        const normalizedScope = String(scope).trim();
        if (!normalizedScope || normalizedScope.length > 100) {
            return res.status(400).json({
                success: false,
                code: 'INVALID_CONSENT_SCOPE',
                message: 'Invalid consent scope.'
            });
        }

        let normalizedExpiresAt = null;
        if (expiresAt) {
            const parsedExpiry = new Date(expiresAt);
            if (Number.isNaN(parsedExpiry.getTime()) || parsedExpiry <= new Date()) {
                return res.status(400).json({
                    success: false,
                    code: 'INVALID_CONSENT_EXPIRY',
                    message: 'Consent expiry must be a valid future date.'
                });
            }
            normalizedExpiresAt = parsedExpiry.toISOString();
        }

        const insertRes = await runDb(
            `INSERT INTO consents (
                id, patient_id, granted_to, hospital_id, purpose, scope,
                status, granted_at, expires_at, created_at
            ) VALUES (
                gen_random_uuid(), ?, ?, ?, ?, ?, 'active',
                CURRENT_TIMESTAMP, ?, CURRENT_TIMESTAMP
            ) RETURNING *`,
            [
                patient.id,
                recipient.id,
                patient.hospitalId || null,
                String(purpose).trim().slice(0, 255),
                normalizedScope,
                normalizedExpiresAt
            ]
        );

        const consent = insertRes.rows?.[0];

        if (!consent) {
            throw new Error('Failed to create consent.');
        }

        realtimeService.emitToChannel(
            `patient:${patient.id}`,
            'CONSENT_CHANGED',
            consent
        );
        realtimeService.emitToUser(
            recipient.id,
            'CONSENT_GRANTED',
            consent
        );

        await writeAuditEvent({
            userId: requester.id,
            role: requester.role,
            hospitalId: patient.hospitalId,
            action: 'CONSENT_GRANTED',
            resourceType: 'consent',
            resourceId: consent.id,
            details: {
                patientId: patient.id,
                grantedTo: recipient.id,
                purpose: String(purpose).trim().slice(0, 255),
                scope: normalizedScope
            },
            status: 'SUCCESS'
        });

        return res.status(201).json({ success: true, consent });
    } catch (err) {
        console.error('[POST /consents] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to create consent.'
        });
    }
});

// 5. POST /api/consents/:id/revoke - Patient revokes their own consent
router.post('/consents/:id/revoke', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId;

        const patient = await getDb(
            `SELECT p.id, p.hospital_id AS "hospitalId", u.status
             FROM patients p
             JOIN users u ON u.id = p.user_id
             WHERE p.user_id = ?
             LIMIT 1`,
            [requesterId]
        );

        if (!patient || patient.status !== 'active') {
            return res.status(403).json({
                success: false,
                code: 'PATIENT_PROFILE_REQUIRED',
                message: 'Active registered patient account required.'
            });
        }

        const { id } = req.params;

        const result = await runDb(
            `UPDATE consents
             SET status = 'revoked',
                 revoked_at = CURRENT_TIMESTAMP
             WHERE id = ?
               AND patient_id = ?
               AND status = 'active'
             RETURNING id, status, revoked_at`,
            [id, patient.id]
        );

        const consent = result.rows?.[0];

        if (!consent) {
            return res.status(404).json({
                success: false,
                message: 'Active consent not found.'
            });
        }

        await writeAuditEvent({
            userId: requesterId,
            role: 'patient',
            hospitalId: patient.hospitalId,
            action: 'CONSENT_REVOKED',
            resourceType: 'consent',
            resourceId: id,
            status: 'SUCCESS'
        });

        return res.json({
            success: true,
            message: 'Consent revoked successfully.',
            consent
        });
    } catch (err) {
        console.error('[POST /consents/:id/revoke] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to revoke consent.'
        });
    }
});

