// 1. GET /api/appointments - Authorization-scoped appointment access
router.get('/appointments', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId;

        const requester = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [requesterId]
        );

        if (!requester || requester.status !== 'active') {
            return res.status(403).json({
                success: false,
                code: 'ACCOUNT_NOT_ACTIVE',
                message: 'Active authenticated account required.'
            });
        }

        const { status } = req.query;
        let rows;

        if (requester.role === 'patient') {
            const patient = await getDb(
                `SELECT id, hospital_id AS "hospitalId"
                 FROM patients
                 WHERE user_id = ?
                 LIMIT 1`,
                [requester.id]
            );

            if (!patient) {
                return res.status(403).json({
                    success: false,
                    code: 'PATIENT_PROFILE_REQUIRED',
                    message: 'Registered patient profile required.'
                });
            }

            rows = await queryDb(
                `SELECT *
                 FROM appointments
                 WHERE patient_id = ?
                   AND (? IS NULL OR status = ?)
                 ORDER BY scheduled_at ASC
                 LIMIT 100`,
                [patient.id, status || null, status || null]
            );
        } else if (requester.role === 'doctor') {
            const doctor = await getDb(
                `SELECT id, hospital_id
                 FROM doctors
                 WHERE user_id = ?
                 LIMIT 1`,
                [requester.id]
            );

            if (!doctor) {
                return res.status(403).json({
                    success: false,
                    code: 'DOCTOR_PROFILE_REQUIRED',
                    message: 'Registered doctor profile required.'
                });
            }

            rows = await queryDb(
                `SELECT *
                 FROM appointments
                 WHERE doctor_id = ?
                   AND hospital_id = ?
                   AND (? IS NULL OR status = ?)
                 ORDER BY scheduled_at ASC
                 LIMIT 100`,
                [doctor.id, doctor.hospital_id, status || null, status || null]
            );
        } else if (['clinical', 'hospital_admin', 'admin', 'super_admin'].includes(requester.role)) {
            if (requester.role === 'super_admin') {
                rows = await queryDb(
                    `SELECT *
                     FROM appointments
                     WHERE (? IS NULL OR status = ?)
                     ORDER BY scheduled_at ASC
                     LIMIT 100`,
                    [status || null, status || null]
                );
            } else {
                rows = await queryDb(
                    `SELECT *
                     FROM appointments
                     WHERE hospital_id = ?
                       AND (? IS NULL OR status = ?)
                     ORDER BY scheduled_at ASC
                     LIMIT 100`,
                    [requester.hospitalId, status || null, status || null]
                );
            }
        } else {
            return res.status(403).json({
                success: false,
                code: 'APPOINTMENT_ACCESS_DENIED',
                message: 'You are not authorized to access appointments.'
            });
        }

        return res.json({ success: true, appointments: rows });
    } catch (err) {
        console.error('[GET /appointments] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to retrieve appointments.',
            appointments: []
        });
    }
});

// 2. POST /api/appointments - Schedule a new appointment
router.post('/appointments', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId;

        const requester = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [requesterId]
        );

        if (!requester || requester.status !== 'active') {
            return res.status(403).json({
                success: false,
                code: 'ACCOUNT_NOT_ACTIVE',
                message: 'Active authenticated account required.'
            });
        }

        if (requester.role !== 'patient') {
            return res.status(403).json({
                success: false,
                code: 'PATIENT_BOOKING_REQUIRED',
                message: 'Only an active patient may create an appointment.'
            });
        }

        const patient = await getDb(
            `SELECT id, hospital_id AS "hospitalId", full_name
             FROM patients
             WHERE user_id = ?
             LIMIT 1`,
            [requester.id]
        );

        if (!patient) {
            return res.status(403).json({
                success: false,
                code: 'PATIENT_PROFILE_REQUIRED',
                message: 'Registered patient profile required.'
            });
        }

        const {
            doctorId,
            scheduledAt,
            timeSlot,
            type,
            notes
        } = req.body || {};

        if (!doctorId || !scheduledAt) {
            return res.status(400).json({
                success: false,
                message: 'doctorId and scheduledAt are required.'
            });
        }

        const parsedScheduledAt = new Date(scheduledAt);

        if (Number.isNaN(parsedScheduledAt.getTime())) {
            return res.status(400).json({
                success: false,
                code: 'INVALID_SCHEDULED_AT',
                message: 'scheduledAt must be a valid date.'
            });
        }

        const doctor = await getDb(
            `SELECT d.id, d.hospital_id, d.specialty,
                    u.id AS user_id, u.name AS doctor_name, u.status AS user_status
             FROM doctors d
             JOIN users u ON u.id = d.user_id
             WHERE d.id = ?
             LIMIT 1`,
            [doctorId]
        );

        if (!doctor || doctor.user_status !== 'active') {
            return res.status(404).json({
                success: false,
                code: 'DOCTOR_NOT_AVAILABLE',
                message: 'Selected doctor is not available.'
            });
        }

        if (
            !patient.hospitalId ||
            !doctor.hospital_id ||
            String(patient.hospitalId) !== String(doctor.hospital_id)
        ) {
            return res.status(403).json({
                success: false,
                code: 'HOSPITAL_ACCESS_DENIED',
                message: 'Appointments may only be scheduled within the patient hospital.'
            });
        }

        const insertRes = await runDb(
            `INSERT INTO appointments (
                id, patient_id, doctor_id, hospital_id, scheduled_at,
                time_slot, status, type, notes, patient_name, doctor_name,
                created_at, updated_at
            ) VALUES (
                gen_random_uuid(), ?, ?, ?, ?, ?, 'scheduled', ?, ?, ?, ?,
                CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
            ) RETURNING *`,
            [
                patient.id,
                doctor.id,
                doctor.hospital_id,
                parsedScheduledAt.toISOString(),
                String(timeSlot || '10:00 AM').slice(0, 50),
                String(type || 'General Consultation').slice(0, 100),
                String(notes || '').slice(0, 5000),
                patient.full_name || requester.name || 'Patient',
                doctor.doctor_name || 'Doctor'
            ]
        );

        const appointment = insertRes.rows?.[0];

        if (!appointment) {
            throw new Error('Failed to create appointment.');
        }

        realtimeService.emitToChannel(
            `patient:${patient.id}`,
            'APPOINTMENT_CREATED',
            appointment
        );

        realtimeService.emitToChannel(
            `doctor:${doctor.id}`,
            'APPOINTMENT_CREATED',
            appointment
        );

        await writeAuditEvent({
            userId: requester.id,
            role: requester.role,
            hospitalId: patient.hospitalId,
            action: 'APPOINTMENT_SCHEDULED',
            resourceType: 'appointment',
            resourceId: appointment.id,
            details: {
                patientId: patient.id,
                doctorId: doctor.id,
                scheduledAt: parsedScheduledAt.toISOString(),
                type: appointment.type
            },
            status: 'SUCCESS'
        });

        return res.status(201).json({
            success: true,
            appointment
        });
    } catch (err) {
        console.error('[POST /appointments] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to create appointment.'
        });
    }
});

