// 6. GET /api/prescriptions - Authorization-scoped medical records
router.get('/prescriptions', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId;

        const requester = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [requesterId]
        );

        if (!requester || requester.status !== 'active') {
            return res.status(403).json({
                success: false,
                code: 'ACCOUNT_NOT_ACTIVE',
                message: 'Active authenticated account required.'
            });
        }

        if (requester.role === 'patient') {
            const patient = await getDb(
                `SELECT id
                 FROM patients
                 WHERE user_id = ?
                 LIMIT 1`,
                [requester.id]
            );

            if (!patient) {
                return res.status(403).json({
                    success: false,
                    code: 'PATIENT_PROFILE_REQUIRED',
                    message: 'Registered patient profile required.'
                });
            }

            const rows = await queryDb(
                `SELECT *
                 FROM prescriptions
                 WHERE patient_id = ?
                 ORDER BY created_at DESC
                 LIMIT 50`,
                [patient.id]
            );

            return res.json({ success: true, prescriptions: rows });
        }

        if (!['doctor', 'clinical'].includes(requester.role)) {
            return res.status(403).json({
                success: false,
                code: 'MEDICAL_ACCESS_DENIED',
                message: 'You are not authorized to access patient prescriptions.'
            });
        }

        const doctor = await getDb(
            `SELECT id, hospital_id
             FROM doctors
             WHERE user_id = ?
             LIMIT 1`,
            [requester.id]
        );

        if (!doctor) {
            return res.status(403).json({
                success: false,
                code: 'DOCTOR_PROFILE_REQUIRED',
                message: 'Registered clinical provider profile required.'
            });
        }

        const requestedPatientId = req.query.patientId;

        if (!requestedPatientId) {
            return res.status(400).json({
                success: false,
                code: 'PATIENT_REQUIRED',
                message: 'patientId is required for clinical prescription access.'
            });
        }

        const patient = await getDb(
            `SELECT id, hospital_id
             FROM patients
             WHERE (id::text = ? OR user_id::text = ?)
               AND hospital_id = ?
             LIMIT 1`,
            [requestedPatientId, requestedPatientId, doctor.hospital_id]
        );

        if (!patient) {
            return res.status(404).json({
                success: false,
                message: 'Patient not found in your hospital.'
            });
        }

        const activeSession = await getDb(
            `SELECT id
             FROM active_access_sessions
             WHERE doctor_id = ?
               AND patient_id = ?
               AND revoked_at IS NULL
               AND expires_at > CURRENT_TIMESTAMP
             LIMIT 1`,
            [doctor.id, patient.id]
        );

        if (!activeSession) {
            return res.status(403).json({
                success: false,
                code: 'PATIENT_ACCESS_REQUIRED',
                message: 'Active patient access approval is required.'
            });
        }

        const rows = await queryDb(
            `SELECT *
             FROM prescriptions
             WHERE patient_id = ?
               AND hospital_id = ?
             ORDER BY created_at DESC
             LIMIT 50`,
            [patient.id, doctor.hospital_id]
        );

        return res.json({ success: true, prescriptions: rows });
    } catch (err) {
        console.error('[GET /prescriptions] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to retrieve prescriptions.',
            prescriptions: []
        });
    }
});

