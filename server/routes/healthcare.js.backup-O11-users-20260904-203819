// 8. GET /api/users - Admin user directory only
router.get('/users', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId || null;
        const requesterEmail = req.user?.email || null;

        const requester = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE (id = ? OR email = ?)
             LIMIT 1`,
            [requesterId, requesterEmail]
        );

        if (!requester || !['admin', 'super_admin'].includes(requester.role)) {
            return res.status(403).json({
                success: false,
                code: 'ADMIN_REQUIRED',
                message: 'Administrator privileges are required to list users.'
            });
        }

        const { role } = req.query;
        let sql = `SELECT id, email, name, phone, role, status,
                          hospital_id AS "hospitalId",
                          created_at AS "createdAt"
                   FROM users
                   WHERE 1=1`;
        const params = [];

        if (role) {
            sql += ` AND role = ?`;
            params.push(role);
        }

        if (requester.role !== 'super_admin') {
            sql += ` AND hospital_id = ?`;
            params.push(requester.hospitalId);
        }

        sql += ` ORDER BY created_at DESC LIMIT 100`;

        const users = await queryDb(sql, params);

        return res.json({ success: true, users });
    } catch (err) {
        console.error('[GET /users] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to retrieve users.',
            users: []
        });
    }
});

// 9. PUT /api/users/:id - Self profile update or admin-managed update
router.put('/users/:id', authMiddleware, async (req, res) => {
    try {
        const requesterId = req.user?.uid || req.user?.userId || null;
        const requesterEmail = req.user?.email || null;
        const targetId = req.params.id;

        const requester = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE (id = ? OR email = ?)
             LIMIT 1`,
            [requesterId, requesterEmail]
        );

        if (!requester || requester.status !== 'active') {
            return res.status(403).json({
                success: false,
                code: 'USER_NOT_ACTIVE',
                message: 'Active authenticated account required.'
            });
        }

        const target = await getDb(
            `SELECT id, role, status, hospital_id AS "hospitalId"
             FROM users
             WHERE id = ?
             LIMIT 1`,
            [targetId]
        );

        if (!target) {
            return res.status(404).json({
                success: false,
                message: 'User not found.'
            });
        }

        const isAdmin = ['admin', 'super_admin'].includes(requester.role);
        const isSelf = String(requester.id) === String(target.id);

        if (!isAdmin && !isSelf) {
            return res.status(403).json({
                success: false,
                code: 'USER_ACCESS_DENIED',
                message: 'You may only update your own profile.'
            });
        }

        if (
            isAdmin &&
            requester.role !== 'super_admin' &&
            requester.hospitalId &&
            target.hospitalId !== requester.hospitalId
        ) {
            return res.status(403).json({
                success: false,
                code: 'HOSPITAL_ACCESS_DENIED',
                message: 'User belongs to another hospital.'
            });
        }

        const { name, phone, avatarUrl, status } = req.body || {};

        // Ordinary users may only modify their own profile fields.
        if (!isAdmin && status !== undefined) {
            return res.status(403).json({
                success: false,
                code: 'STATUS_UPDATE_FORBIDDEN',
                message: 'Only administrators may change account status.'
            });
        }

        // Only administrators may change status, and only to known lifecycle states.
        const allowedStatuses = ['active', 'pending', 'rejected', 'suspended'];

        if (status !== undefined && !allowedStatuses.includes(String(status))) {
            return res.status(400).json({
                success: false,
                code: 'INVALID_STATUS',
                message: 'Invalid user status.'
            });
        }

        await runDb(
            `UPDATE users SET
                name = COALESCE(?, name),
                phone = COALESCE(?, phone),
                avatar_url = COALESCE(?, avatar_url),
                status = COALESCE(?, status),
                updated_at = CURRENT_TIMESTAMP
             WHERE id = ?`,
            [
                name !== undefined ? String(name).trim() || null : null,
                phone !== undefined ? String(phone).trim() || null : null,
                avatarUrl !== undefined ? String(avatarUrl).trim() || null : null,
                isAdmin && status !== undefined ? String(status) : null,
                target.id
            ]
        );

        await writeAuditEvent({
            actorId: requester.id,
            actorRole: requester.role,
            action: 'USER_PROFILE_UPDATED',
            resourceType: 'user',
            resourceId: target.id,
            metadata: {
                selfUpdate: isSelf,
                statusChanged: isAdmin && status !== undefined
            }
        });

        return res.json({
            success: true,
            message: 'User updated successfully'
        });
    } catch (err) {
        console.error('[PUT /users/:id] error:', err.message);
        return res.status(500).json({
            success: false,
            message: 'Unable to update user.'
        });
    }
});

export default router;
