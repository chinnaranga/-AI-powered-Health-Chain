# HealthChain Enterprise Production Environment Variables
# Copy this file to .env and replace placeholder values with actual production credentials.

# Primary Database: Neon PostgreSQL (Serverless Cloud PostgreSQL)
# Example: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Port & App URLs
PORT=3001
BACKEND_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# JWT Token Protection
JWT_SECRET=healthchain-enterprise-jwt-secret-key-2026
JWT_REFRESH_SECRET=healthchain-enterprise-refresh-secret-key-2026

# Cloudflare R2 Heavy & Sensitive File Storage (S3-Compatible)
R2_ACCOUNT_ID=healthchain_r2_account_id
R2_BUCKET_NAME=healthchain-sensitive-docs
R2_ACCESS_KEY_ID=healthchain_r2_access_key
R2_SECRET_ACCESS_KEY=healthchain_r2_secret_key_2026
R2_ENDPOINT=https://healthchain_r2_account_id.r2.cloudflarestorage.com

# SMTP Email Notification Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=healthchain_smtp_user
SMTP_PASSWORD=healthchain_smtp_pass

# Additional Encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
