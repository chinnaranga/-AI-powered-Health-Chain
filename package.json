{
  "name": "blockchain-health",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "setup": "node server/bootstrap.js",
    "server": "node server/server.js",
    "migrate": "node server/config/migrate.js",
    "verify:db": "node server/verify_neon.js",
    "clean:db": "node server/clean_data.js",
    "dev": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" concurrently \"npm run server\" \"vite\"",
    "dev:full": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" concurrently \"npm run chain\" \"npm run server\" \"vite\"",
    "chain": "hardhat node --config blockchain/hardhat.config.cjs",
    "compile:contract": "hardhat compile --config blockchain/hardhat.config.cjs",
    "deploy:contract": "hardhat run blockchain/scripts/deploy.cjs --network localhost --config blockchain/hardhat.config.cjs",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" vite build",
    "deploy:cloudrun": "bash deploy-cloudrun.sh",
    "deploy:firebase": "npm run build && firebase deploy --only firestore,hosting,storage",
    "lint": "eslint .",
    "preview": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" vite preview"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@react-oauth/google": "^0.12.1",
    "@tanstack/react-query": "^5.90.21",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "firebase": "^11.10.0",
    "framer-motion": "^12.34.3",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.14.2",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "nodemon": "^3.1.11",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.1.0",
    "react-is": "^18.3.1",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.6.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "hardhat": "^2.28.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.0"
  }
}
